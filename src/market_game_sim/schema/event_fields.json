            }
          ]
        },
        "side": {
          "value_type": "enum",
          "enum": [
            "BUY",
            "SELL"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "order_type": {
          "value_type": "enum",
          "enum": [
            "LIMIT",
            "MARKET"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE",
