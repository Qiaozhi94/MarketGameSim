      "int",
      "str",
      "bool",
      "enum",
      "array",
      "object"
    ],
    "hash_classes": [
      "HASH_INCLUDE",
      "HASH_EXCLUDE"
    ],
    "required_values": [
      "always",
      "conditional"
    ],
    "note": "required=conditional 时必须同时给出 required_when；hash 对 RUN_HEADER / RUN_TRAILER 恒为 HASH_EXCLUDE（整条记录不参与摘要哈希）。"
  },
  "record_kinds": [
