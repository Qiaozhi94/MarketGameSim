{
  "$comment": "事件日志字段的规范真源（合同产物，随 docs/contracts/event-schema.md 一同评审）。此文件不是实现细节：registry.py 只负责加载它，不得内嵌第二份声明。放在包内而非 docs/ 是因为 wheel 只打包 src/market_game_sim，装包后须能由 importlib.resources 读取。",
  "schema_version": 4,
  "meta": {
    "field_metadata_keys": [
      "value_type",
      "enum",
      "nullable",
      "required",
      "hash"
    ],
    "value_types": [
      "int",
      "str",
      "bool",
      "enum",
      "array",
      "object"
    ],
    "hash_classes": [
      "HASH_INCLUDE",
      "HASH_EXCLUDE"
    ],
    "required_values": [
      "always"
    ],
    "note": "字段一律【恒存在】：required 只有 always，序列化不得省略任何字段（事件 Schema §9）。条件性表达的是【值】而非【是否存在】，写在结构化 constraints 中，不使用自然语言。constraints 的 then 取 null | non_null；when 为可判定谓词。hash 对 RUN_HEADER / RUN_TRAILER 恒为 HASH_EXCLUDE。",
    "constraint_grammar": {
      "$comment": "constraints 的封闭语法。validator 遇到未在此声明的谓词/操作符/上下文键必须【失败】，不得忽略——忽略与失败会产生两个都自称合法的实现。",
      "object_shape": {
        "required_keys": [
          "when",
          "then"
        ],
        "optional_keys": [
          "note"
        ],
        "$comment": "每个 constraint 对象恰有 when 与 then；说明性文字放 note，不得出现只有 $comment 的对象"
      },
      "then_values": [
        "null",
        "non_null"
      ],
      "when_forms": [
        {
          "form": "same_record_equals",
          "keys": [
            "field",
            "equals"
          ],
          "semantics": "同一记录内 field 的值等于 equals",
          "operand_types": [
            "str",
            "bool",
            "int"
          ]
        },
        {
          "form": "same_record_in",
          "keys": [
            "field",
            "in"
          ],
          "semantics": "同一记录内 field 的值属于 in 列表",
          "operand_types": [
            "array<str>"
          ]
        },
        {
          "form": "always",
          "keys": [
            "always"
          ],
          "semantics": "无条件成立",
          "operand_types": [
            "bool"
          ]
        },
        {
          "form": "queueing",
          "keys": [
            "queueing"
          ],
          "semantics": "按所属事件类型的 queueing 分类（queue_event / transaction_record）",
          "operand_types": [
            "str"
          ],
          "domain": [
            "queue_event",
            "transaction_record"
          ]
        },
        {
          "form": "account_has_position",
          "keys": [
            "account_has_position"
          ],
          "semantics": "该分录/快照对应账户的 position_units != 0",
          "operand_types": [
            "bool"
          ]
        },
        {
          "form": "side_empty",
          "keys": [
            "side_empty"
          ],
          "semantics": "订单簿该侧无挂单",
          "operand_types": [
            "str"
          ],
          "domain": [
            "BID",
            "ASK"
          ]
        },
        {
          "form": "no_trade_yet",
          "keys": [
            "no_trade_yet"
          ],
          "semantics": "本次运行尚无成交",
          "operand_types": [
            "bool"
          ]
        },
        {
          "form": "no_committed_transaction",
          "keys": [
            "no_committed_transaction"
          ],
          "semantics": "尚无已提交事务",
          "operand_types": [
            "bool"
          ]
        }
      ],
      "extension_rule": "需要新谓词时必须【先】在 when_forms 中声明再使用；就地发明谓词会使 validator 与合同脱钩。"
    }
  },
  "record_kinds": [
    "RUN_HEADER",
    "EVENT",
    "RUN_TRAILER"
  ],
  "structures": {
    "RUN_HEADER": {
      "kind": "top_level",
      "hash": "HASH_EXCLUDE",
      "fields": {
        "record_kind": {
          "value_type": "enum",
          "enum": [
            "RUN_HEADER"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "schema_version": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "run_id": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "code_version": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "config_hash": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "master_seed": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "started_at_wall": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "tick_size": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "min_quantity": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "cash_unit": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "run_mode": {
          "value_type": "enum",
          "enum": [
            "benchmark",
            "research",
            "interactive"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "information_set_mode": {
          "value_type": "enum",
          "enum": [
            "digest",
            "full"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "mult": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "fee_bps_cap": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "initial_price_ticks": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "agent_initial_bp": {
          "value_type": "object",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        }
      }
    },
    "RUN_TRAILER": {
      "kind": "top_level",
      "hash": "HASH_EXCLUDE",
      "fields": {
        "record_kind": {
          "value_type": "enum",
          "enum": [
            "RUN_TRAILER"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "terminated": {
          "value_type": "enum",
          "enum": [
            "COMPLETED",
            "ABORTED"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "abort_code": {
          "value_type": "enum",
          "enum": [
            "QUEUE_KEY_MONOTONICITY",
            "CLASS_REGRESSION_NOT_WHITELISTED",
            "CONSERVATION_BREACH",
            "ILLEGAL_STATE_TRANSITION",
            "CONFIG_INVARIANT",
            "INTERNAL"
          ],
          "nullable": true,
          "required": "always",
          "hash": "HASH_EXCLUDE",
          "constraints": [
            {
              "when": {
                "field": "terminated",
                "equals": "ABORTED"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "terminated",
                "equals": "COMPLETED"
              },
              "then": "null"
            }
          ]
        },
        "abort_detail": {
          "value_type": "str",
          "nullable": true,
          "required": "always",
          "hash": "HASH_EXCLUDE",
          "note": "诊断文本，随平台变化，不得被程序解析",
          "constraints": [
            {
              "when": {
                "field": "terminated",
                "equals": "COMPLETED"
              },
              "then": "null"
            }
          ]
        },
        "last_committed_transaction_seq": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_EXCLUDE",
          "note": "正常结束恒 >= 2（两条 bootstrap 快照事务）；第二张快照失败时为 1；第一张失败时为 null",
          "constraints": [
            {
              "when": {
                "no_committed_transaction": true
              },
              "then": "null"
            }
          ]
        },
        "record_count": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        }
      }
    },
    "EVENT_COMMON": {
      "kind": "event_common",
      "fields": {
        "record_kind": {
          "value_type": "enum",
          "enum": [
            "EVENT"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "schema_version": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "event_id": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "run_id": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        },
        "timestamp": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "transaction_seq": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "record_index": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "priority_class": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "event_type": {
          "value_type": "enum",
          "enum": [
            "ORDER_ARRIVAL",
            "ORDER_CANCELLED",
            "TRADE_SETTLE",
            "MARGIN_CALL",
            "MARKET_DATA_PUBLISH",
            "AGENT_OBSERVE",
            "AGENT_DECIDE",
            "SNAPSHOT"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "enqueue_seq": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "queueing": "queue_event"
              },
              "then": "non_null"
            },
            {
              "when": {
                "queueing": "transaction_record"
              },
              "then": "null"
            }
          ]
        }
      }
    },
    "ORDER_ARRIVAL": {
      "kind": "event",
      "priority_class": 0,
      "queueing": "queue_event",
      "fields": {
        "agent_id": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "order_id": {
          "value_type": "str",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "action": {
          "value_type": "enum",
          "enum": [
            "SUBMIT",
            "CANCEL"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "target_order_id": {
          "value_type": "str",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "action",
                "equals": "CANCEL"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "action",
                "equals": "SUBMIT"
              },
              "then": "null"
            }
          ]
        },
        "side": {
          "value_type": "enum",
          "enum": [
            "BUY",
            "SELL"
          ],
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "action",
                "equals": "SUBMIT"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "action",
                "equals": "CANCEL"
              },
              "then": "null"
            }
          ]
        },
        "order_type": {
          "value_type": "enum",
          "enum": [
            "LIMIT",
            "MARKET"
          ],
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "action",
                "equals": "SUBMIT"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "action",
                "equals": "CANCEL"
              },
              "then": "null"
            }
          ]
        },
        "price_ticks": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "order_type",
                "equals": "MARKET"
              },
              "then": "null"
            },
            {
              "when": {
                "field": "order_type",
                "equals": "LIMIT"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "action",
                "equals": "CANCEL"
              },
              "then": "null"
            }
          ]
        },
        "quantity_units": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "action",
                "equals": "SUBMIT"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "action",
                "equals": "CANCEL"
              },
              "then": "null"
            }
          ]
        },
        "accepted": {
          "value_type": "bool",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "reject_reason": {
          "value_type": "enum",
          "enum": [
            "TICK_MISALIGNED",
            "QUANTITY_MISALIGNED",
            "INSUFFICIENT_MARGIN",
            "REGIME_HOOK",
            "UNKNOWN_ORDER",
            "LIQUIDATION_STALE"
          ],
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "accepted",
                "equals": false
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "accepted",
                "equals": true
              },
              "then": "null"
            }
          ]
        },
        "reserved_delta_units": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "origin": {
          "value_type": "enum",
          "enum": [
            "AGENT",
            "LIQUIDATION",
            "EXOGENOUS_STRESS"
          ],
          "nullable": false,
          "required": "always",
          "hash": "HASH_INCLUDE"
        },
        "trigger_ratio_bp": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "origin",
                "equals": "LIQUIDATION"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "origin",
                "equals": "AGENT"
              },
              "then": "null"
            }
          ]
        },
        "liquidation_generation": {
          "value_type": "int",
          "nullable": true,
          "required": "always",
          "hash": "HASH_INCLUDE",
          "constraints": [
            {
              "when": {
                "field": "origin",
                "equals": "LIQUIDATION"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "origin",
                "equals": "AGENT"
              },
              "then": "null"
            }
          ]
        },
        "intent_id": {
          "value_type": "str",
          "nullable": true,
          "required": "always",
          "hash": "HASH_EXCLUDE",
          "constraints": [
            {
              "when": {
                "field": "origin",
                "equals": "AGENT"
              },
              "then": "non_null"
            },
            {
              "when": {
                "field": "origin",
                "equals": "LIQUIDATION"
              },
              "then": "null"
            }
          ]
        },
        "decision_event_id": {
          "value_type": "str",
          "nullable": true,
          "required": "always",
          "hash": "HASH_EXCLUDE",
          "constraints": [
            {
              "when": {
                "always": true
              },
              "then": "non_null"
            }
          ],
          "note": "origin=AGENT 或 EXOGENOUS_STRESS 时指向 AGENT_DECIDE；origin=LIQUIDATION 时指向 MARGIN_CALL（chain_depth 的唯一来源）"
        },
        "submitted_at": {
          "value_type": "int",
          "nullable": false,
          "required": "always",
          "hash": "HASH_EXCLUDE"
        }
      }
    },
    "ORDER_CANCELLED": {
